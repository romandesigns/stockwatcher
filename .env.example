# Copy to .env (gitignored) on each host. Never commit the real file.

# Shared secret for /api/* (except /api/health) and /ws. At least 32 chars.
# Leave unset in local dev to run with auth off (the server logs a warning).
# Generate one with: openssl rand -hex 32
STOCKWATCHER_API_TOKEN=

# HTTP port (default 8790). The image binds 0.0.0.0; local dev binds 127.0.0.1.
PORT=8790

# Log filter, tracing EnvFilter syntax.
RUST_LOG=info,stockwatcher_server=debug

# Optional overrides (defaults shown):
# HOST=127.0.0.1
# STATIC_DIR=./apps/web/dist
# DATA_DIR=./data
# LOG_FORMAT=pretty   # or json (the image uses json)

# Market data: replay (default) or live. Live streams from Alpaca and needs both keys
# (APCA_API_KEY_ID / APCA_API_SECRET_KEY are accepted too). Alpaca allows one stream
# connection per account on most plans, so run live on one host only.
# MARKET_DATA_MODE=replay
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ALPACA_STREAM_BASE=wss://stream.data.alpaca.markets
# Feed: sip, iex, boats, overnight, or test (Alpaca's fake FAKEPACA stream).
# ALPACA_STREAM_FEED=sip
# Symbols: * (whole market) or a comma list.
# LIVE_SYMBOLS=*
