{
  "about": "Golden cases for a drawing's level at a candle: crates/server/src/alerts/geometry.rs level_at and packages/chart-core/src/drawingAlerts.ts drawingLevelAt read this same file. slots = the chart's slot times (candles and gap runs, ms); t = the candle's start; expect null = the level is not there (inactive).",
  "cases": [
    {
      "name": "hline is flat",
      "tfMs": 60000,
      "slots": [0, 60000, 120000],
      "drawing": { "id": "h", "kind": "hline", "a": { "t": 60000, "p": 1.85 }, "b": { "t": 60000, "p": 1.85 } },
      "queries": [
        { "t": 9000000, "part": "line", "expect": 1.85 },
        { "t": 60000, "part": "stop", "expect": null }
      ]
    },
    {
      "name": "trend across a gap: straight in slots, bent in time",
      "tfMs": 60000,
      "slots": [0, 60000, 120000, 180000, 600000, 660000, 720000],
      "drawing": { "id": "t", "kind": "trend", "a": { "t": 0, "p": 1.0 }, "b": { "t": 600000, "p": 1.4 } },
      "queries": [
        { "t": 120000, "part": "line", "expect": 1.2 },
        { "t": 180000, "part": "line", "expect": 1.3 },
        { "t": 390000, "part": "line", "expect": 1.35 },
        { "t": 600000, "part": "line", "expect": 1.4 },
        { "t": 660000, "part": "line", "expect": null },
        { "t": -60000, "part": "line", "expect": null }
      ]
    },
    {
      "name": "ray runs past b and into candles not printed yet",
      "tfMs": 60000,
      "slots": [0, 60000, 120000, 180000, 600000, 660000, 720000],
      "drawing": { "id": "r", "kind": "ray", "a": { "t": 0, "p": 1.0 }, "b": { "t": 120000, "p": 1.1 } },
      "queries": [
        { "t": 660000, "part": "line", "expect": 1.25 },
        { "t": 720000, "part": "line", "expect": 1.3 },
        { "t": 840000, "part": "line", "expect": 1.4 },
        { "t": -60000, "part": "line", "expect": null }
      ]
    },
    {
      "name": "ray pointing back in time never reaches a new candle",
      "tfMs": 60000,
      "slots": [0, 60000, 120000, 180000, 600000, 660000, 720000],
      "drawing": { "id": "rb", "kind": "ray", "a": { "t": 600000, "p": 1.4 }, "b": { "t": 0, "p": 1.0 } },
      "queries": [
        { "t": 720000, "part": "line", "expect": null },
        { "t": 120000, "part": "line", "expect": 1.2 }
      ]
    },
    {
      "name": "trend with its anchors placed right to left",
      "tfMs": 60000,
      "slots": [0, 60000, 120000, 180000, 600000, 660000, 720000],
      "drawing": { "id": "tr", "kind": "trend", "a": { "t": 600000, "p": 1.4 }, "b": { "t": 0, "p": 1.0 } },
      "queries": [
        { "t": 120000, "part": "line", "expect": 1.2 },
        { "t": 660000, "part": "line", "expect": null }
      ]
    },
    {
      "name": "vertical trend has no price",
      "tfMs": 60000,
      "slots": [0, 60000],
      "drawing": { "id": "v", "kind": "trend", "a": { "t": 60000, "p": 1.0 }, "b": { "t": 60000, "p": 2.0 } },
      "queries": [{ "t": 60000, "part": "line", "expect": null }]
    },
    {
      "name": "long position: entry, target and stop are flat levels",
      "tfMs": 15000,
      "slots": [0, 15000],
      "drawing": { "id": "p", "kind": "long", "a": { "t": 0, "p": 2.0 }, "b": { "t": 15000, "p": 2.4 }, "c": { "t": 15000, "p": 1.8 } },
      "queries": [
        { "t": 999000, "part": "entry", "expect": 2.0 },
        { "t": 999000, "part": "target", "expect": 2.4 },
        { "t": 999000, "part": "stop", "expect": 1.8 },
        { "t": 999000, "part": "line", "expect": null }
      ]
    },
    {
      "name": "anchor older than the first slot: one slot per interval (the documented approximation)",
      "tfMs": 60000,
      "slots": [600000, 660000, 720000],
      "drawing": { "id": "o", "kind": "trend", "a": { "t": 0, "p": 1.0 }, "b": { "t": 720000, "p": 2.2 } },
      "queries": [
        { "t": 660000, "part": "line", "expect": 2.1 },
        { "t": 600000, "part": "line", "expect": 2.0 }
      ]
    }
  ]
}
